# Aplic Gráfica — exemplo público, sem credenciais.
# Copie para .env.local; não versione o arquivo com valores privados.

# Origem usada para URLs canônicas e metadados.
NEXT_PUBLIC_SITE_URL=https://aplicgrafica.com.br

# Contêiner Google Tag Manager. Vazio evita carregar o GTM no desenvolvimento.
# Isso não desativa o Atlas/Pixerun, que possui carregador próprio no layout.
NEXT_PUBLIC_GTM_ID=

# VERCEL_ENV é fornecida pela Vercel; não simule produção para QA local.
